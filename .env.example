APP_NAME=OneLink

# Public base URL of this OneLink instance. Used for all internal links
# (captive portal redirect, MikroTik provisioning scripts, walled-garden rules).
# Example: https://onelink.example.com
APP_URL=

# TunGuard API (see https://github.com/TunGuard/tanguard-binary).
# The API key is generated in the TunGuard dashboard: Settings -> API Key.
TUNGARD_API_URL=http://127.0.0.1:9000
TUNGARD_API_KEY=

# Optional: override the WireGuard endpoint advertised to routers.
# Defaults to the host of APP_URL.
WG_ENDPOINT=

# SMS gateway (services/sms.php). Leave blank to use the built-in defaults.
SMS_API_URL=
SMS_API_KEY=
